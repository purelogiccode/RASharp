<Project>
  <PropertyGroup>
    <!-- Each project declares its own TargetFrameworks: RetroAchievementsSharp,
         RetroAchievementsSharp.Cli and RetroAchievementsSharp.Tests all multi-target net8.0;net9.0;net10.0.
         CHDSharp and VideoGameFileSystemParser 1.2.0 ship portable libs for
         all three, and Serilog 4.4.0 covers net8.0+, so the same code builds
         and runs on every supported TFM. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code-quality analyzers (build-time only, never a runtime dependency) -->
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.156" PrivateAssets="all" />
  </ItemGroup>
</Project>