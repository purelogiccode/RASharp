<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>RetroAchievementsSharp</PackageId>
    <Version>1.0.0</Version>
    <Authors>Peterson Fernandes; Pure Logic Code</Authors>
    <Owners>Peterson Fernandes; Pure Logic Code</Owners>
    <Title>RetroAchievementsSharp</Title>
    <Description>A native C# port of the RetroAchievements hashing engine (rcheevos/RAHasher, MIT) that produces 100% identical hashes to the original for every supported console. Supports cartridge, disc (.cue/.bin/.iso/.gdi/.chd/.rvz/.wia), zip, m3u, Arcade, DOS and 3DS inputs.</Description>
    <PackageTags>RetroAchievements;rcheevos;RAHasher;hash;hashing;rom;iso;disc;chd;rvz;wia;gamecube;wii;3ds;nes;snes;n64;playstation</PackageTags>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/purelogiccode/RetroAchievementsSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/purelogiccode/RetroAchievementsSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>master</RepositoryBranch>
    <PackageReleaseNotes>https://github.com/purelogiccode/RetroAchievementsSharp/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 Peterson Fernandes (drpetersonfernandes) and Pure Logic Code</Copyright>

    <!-- symbols, source link and reproducible packs -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>

    <!-- XML docs are packed (GenerateDocumentationFile); CS1591 (missing
         doc comments) is an error via Directory.Build.props
         (TreatWarningsAsErrors), so new public members must be documented -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- guards consumer compatibility on every future pack build -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <Company>PureLogicCode.com</Company>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CHDSharp" Version="1.2.0" />
    <PackageReference Include="RVZSharp" Version="1.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="VideoGameFileSystemParser" Version="1.2.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="icon\icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RetroAchievementsSharp.Tests" />
  </ItemGroup>

</Project>