<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <AssemblyName>RetroAchievementsSharp.Cli</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <ApplicationIcon>icon\icon.ico</ApplicationIcon>
        <Company>PureLogicCode.com</Company>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RetroAchievementsSharp\RetroAchievementsSharp.csproj" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.157" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RetroAchievementsSharp.Tests" />
    </ItemGroup>

</Project>